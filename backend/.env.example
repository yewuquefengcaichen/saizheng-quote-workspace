SAIZHENG_APP_NAME=赛正报价工作台 V2 API
SAIZHENG_APP_VERSION=0.1.0
SAIZHENG_ENVIRONMENT=development
SAIZHENG_DEBUG=true
SAIZHENG_API_V1_PREFIX=/api/v1
SAIZHENG_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/saizheng_quote_v2
SAIZHENG_REDIS_URL=redis://127.0.0.1:6379/0
SAIZHENG_SQLALCHEMY_ECHO=false
SAIZHENG_LEGACY_MALL_BASE_URL=https://sz.dinghuovip.com
SAIZHENG_LEGACY_FILE_BASE_URL=https://udeanfile.dinghuovip.com
SAIZHENG_MALL_SCRAPE_START_URL=
SAIZHENG_MALL_SCRAPE_PAGE_URL_TEMPLATE=
SAIZHENG_MALL_SCRAPE_STORAGE_STATE_PATH=
SAIZHENG_MALL_SCRAPE_HEADLESS=true
SAIZHENG_MALL_SCRAPE_MAX_PAGES=3
SAIZHENG_MALL_SCRAPE_PAGE_TIMEOUT_MS=30000
SAIZHENG_IMAGE_ARCHIVE_ROOT=backend/storage/image_archive
SAIZHENG_IMAGE_ARCHIVE_BACKEND=local_fs
SAIZHENG_IMAGE_ARCHIVE_BUCKET=saizheng-v2-image-archive
SAIZHENG_IMAGE_REQUEST_TIMEOUT_SECONDS=20
SAIZHENG_IMAGE_EMBEDDING_PROVIDER=local_hash_embedding
SAIZHENG_IMAGE_EMBEDDING_MODEL_NAME=phash_dhash_128d_v1
SAIZHENG_IMAGE_EMBEDDING_VECTOR_DIM=128
